    "allow-cancel-state-transfer",
    "allow-verify-state-transfer",
    "allow-get-storage-limits",
    "allow-set-storage-limits",
    "allow-inspect-saved-state",
    "allow-list-saved-state-recovery",
    "allow-prepare-saved-state-management",
    "allow-confirm-saved-state-management",
